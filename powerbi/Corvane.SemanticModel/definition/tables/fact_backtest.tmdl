	partition fact_backtest = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "backtest_predictions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"store_id", "date", "open", "usable", "sales", "fold", "naive", "prophet", "gbm", "ensemble"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"store_id", Int64.Type}, {"date", type date}, {"open", Int64.Type}, {"usable", Int64.Type}, {"sales", type number}, {"fold", Int64.Type}, {"naive", type number}, {"prophet", type number}, {"gbm", type number}, {"ensemble", type number}}, "en-US"),
				    Long = Table.Unpivot(Typed, {"naive", "prophet", "gbm", "ensemble"}, "model", "prediction"),
				    Label = Table.AddColumn(Long, "model_label", each if [model] = "naive" then "Baseline" else if [model] = "prophet" then "Prophet" else if [model] = "gbm" then "Gradient boosting" else "Ensemble", type text),
				    Order = Table.AddColumn(Label, "model_order", each if [model] = "naive" then 1 else if [model] = "prophet" then 2 else if [model] = "gbm" then 3 else 4, Int64.Type),
				    Window = Table.AddColumn(Order, "backtest_window", each if [fold] = 1 then "1 · Jun-Jul 2025" else if [fold] = 2 then "2 · Sep-Oct 2025" else "3 · Nov-Dec 2025", type text)
				in
				    Window

	annotation PBI_ResultType = Table
