	measure 'Title Tooltip' = FORMAT ( MAX ( dim_date[date] ), "dddd d mmm yyyy" )
		displayFolder: 7 Dynamic text
		lineageTag: b04f7e72-3b69-568f-ae18-5d72fe5b64cb

	measure 'Title Forecast Trend' = "Daily sales: actual Oct–Dec 2025 and forecast to 11 Feb 2026  ·  " & [Selected Model Label]
		displayFolder: 7 Dynamic text
		lineageTag: 62713267-cb3c-501f-b392-2310d7086b6d

	measure 'Title Store' = SELECTEDVALUE ( dim_store[store_name], "Multiple stores" ) & "  ·  " & SELECTEDVALUE ( dim_store[format], "" ) & " store detail"
		displayFolder: 7 Dynamic text
		lineageTag: 00d247f5-6a8c-58a8-857e-b2a1eed53ce7

	measure 'Title Accuracy Trend' = "Backtests: actual vs " & [Selected Model Label] & " vs baseline (three 6-week windows)"
		displayFolder: 7 Dynamic text
		lineageTag: d442a22c-6db5-5b30-848e-c44eb04e6049

	measure 'vs LY Color' = IF ( [Forecast vs LY %] >= 0, "#0E7C86", "#B5523B" )
		isHidden
		displayFolder: 8 Formatting
		lineageTag: 67ab488c-0eff-5f4e-89cf-0c025a9a8d63

	measure 'WAPE Heat' = VAR w = [WAPE] RETURN SWITCH ( TRUE (), ISBLANK ( w ), BLANK (), w < 0.05, "#D3ECEE", w < 0.07, "#EEF6F6", w < 0.09, "#F7E6CC", "#F3D7CF" )
		isHidden
		displayFolder: 8 Formatting
		lineageTag: c7aa0d9d-b260-5617-85db-36eb7cce9661

	measure 'Model Color' = IF ( SELECTEDVALUE ( fact_backtest[model] ) = [Selected Model], "#1F4E79", IF ( SELECTEDVALUE ( fact_backtest[model] ) = "naive", "#B8C2CF", "#7FA3C7" ) )
		isHidden
		displayFolder: 8 Formatting
		lineageTag: 6501ffd3-d780-585f-9ac4-083c0e6cf343

	measure 'Effect Color' = IF ( [Estimated Effect] >= 0, "#0E7C86", "#B5523B" )
		isHidden
		displayFolder: 8 Formatting
		lineageTag: 44914d7e-914a-5063-bc65-8aa03fef5335

	measure 'Neutral Color' = "#64748B"
		isHidden
		displayFolder: 8 Formatting
		lineageTag: c5c10275-184e-58fa-b79f-b750cddb4b63

	column Value
		dataType: string
		isHidden
		lineageTag: 22ddf2a6-30dd-5bfc-ba15-0b009ddcaaf6
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				#table(type table [Value = text], {})

	annotation PBI_ResultType = Table
