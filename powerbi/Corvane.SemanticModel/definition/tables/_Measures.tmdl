	measure 'Promo Lift Neighborhood' = CALCULATE ( [Estimated Effect], driver_effects[effect] = "Promotion lift, Neighborhood (basic assortment)" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Drivers
