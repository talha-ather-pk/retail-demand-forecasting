table _Measures
	lineageTag: 31a6320f-1a2a-5b2c-9536-eaf39bcfe5bb

	measure 'Actual Sales' = SUM ( fact_sales[sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 History
		lineageTag: b00669da-b3e5-5f5b-b94b-c13b322410aa

	measure 'Open Store Days' = CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[usable] = 1 )
		formatString: #,0
		displayFolder: 1 History
		lineageTag: 888523d3-b80d-5ca1-bccd-964df952b623

	measure 'Avg Sales per Open Day' = DIVIDE ( CALCULATE ( [Actual Sales], fact_sales[usable] = 1 ), [Open Store Days] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 History
		lineageTag: 74f6d30a-66b7-5a61-af8e-23e05143aee6

	measure Customers = SUM ( fact_sales[customers] )
		formatString: #,0
		displayFolder: 1 History
		lineageTag: 4edb8edd-28ab-5d4d-884b-c72f2652ff40

	measure 'Avg Basket' = DIVIDE ( [Actual Sales], [Customers] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 History
		lineageTag: 51b2821f-652e-512c-a94f-a786c66adbae

	measure 'Actual Sales (Recent)' = IF ( MAX ( dim_date[date] ) >= DATE ( 2025, 10, 1 ), [Actual Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 History
		lineageTag: 3a53e0c5-dc98-5823-9ee2-422c377f4e27

	measure 'Actual Sales 2025' = CALCULATE ( [Actual Sales], dim_date[year] = 2025 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 History
		lineageTag: b22daf6d-1419-55cc-8876-bcda22f9ca24

	measure 'Actual Sales 2024' = CALCULATE ( [Actual Sales], dim_date[year] = 2024 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 History
		lineageTag: 4ee838ef-c384-533e-b809-15d52fe7f3ab

	measure 'Sales Growth 2025' = DIVIDE ( [Actual Sales 2025] - [Actual Sales 2024], [Actual Sales 2024] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 History
		lineageTag: 2c548b26-f671-5b1a-9cc4-2805aec39a35

	measure Forecast = SUM ( fact_forecast[forecast] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: 09d03364-f6d4-5d91-b7fa-ed61d179a90a

	measure 'Forecast P10' = SUM ( fact_forecast[p10] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: b8724a73-a90d-5fcd-a738-b4beab6075d6

	measure 'Forecast P90' = SUM ( fact_forecast[p90] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: 797fa9a1-9b67-56e2-be31-692fa5ed4c23

	measure 'Forecast Prophet' = SUM ( fact_forecast[forecast_prophet] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: 1937ecca-70e4-524c-b63e-97946fb8c3ef

	measure 'Forecast Gradient Boosting' = SUM ( fact_forecast[forecast_gbm] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: dcdb1c5f-c6f6-5ab6-9f4d-dc92c0f2b807

	measure 'Sales Same Dates LY' = CALCULATE ( [Actual Sales], REMOVEFILTERS ( dim_date ), TREATAS ( SELECTCOLUMNS ( VALUES ( fact_forecast[date] ), "d", fact_forecast[date] - 365 ), dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Forecast
		lineageTag: 1c76ce8b-879a-554d-aa08-0aab9c1ce54f

	measure 'Forecast vs LY %' = DIVIDE ( [Forecast] - [Sales Same Dates LY], [Sales Same Dates LY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Forecast
		lineageTag: efbad48d-a851-5c45-8771-16583d2d922d

	measure 'Forecast Range Label' = FORMAT ( [Forecast P10] / 1000000, "$0.00" ) & "M  –  " & FORMAT ( [Forecast P90] / 1000000, "$0.00" ) & "M"
		displayFolder: 2 Forecast
		lineageTag: f7589874-3723-5756-9db7-7bb824d6a05a

	measure 'Forecast vs LY Label' = IF ( ISBLANK ( [Sales Same Dates LY] ), "", FORMAT ( [Forecast vs LY %], "▲ 0.0%;▼ 0.0%;● 0.0%" ) & "  vs same dates 2025" )
		displayFolder: 2 Forecast
		lineageTag: 8bee0fde-b87e-5703-a444-977f88d53a54

	measure 'Forecast Days' = COUNTROWS ( VALUES ( fact_forecast[date] ) )
		formatString: #,0
		isHidden
		displayFolder: 2 Forecast
		lineageTag: ad6751a0-c8d1-5f9c-af6b-e2483b031aa7

	measure 'Selected Model' = SELECTEDVALUE ( fact_forecast[model], "ensemble" )
		isHidden
		displayFolder: 2 Forecast
		lineageTag: 6e7b03b3-852c-58a9-90a9-ae073c6b082c

	measure 'Selected Model Label' = SWITCH ( [Selected Model], "gbm", "Gradient boosting", "prophet", "Prophet", "ensemble", "Ensemble (Prophet + GBM)", "Baseline" )
		displayFolder: 2 Forecast
		lineageTag: 298ea242-49e6-5734-8b26-5c6d70c86db7

	measure 'Backtest Actual' = CALCULATE ( SUM ( fact_backtest[sales] ), fact_backtest[usable] = 1, REMOVEFILTERS ( fact_backtest[model], fact_backtest[model_label], fact_backtest[model_order] ), fact_backtest[model] = "naive" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 Accuracy
		lineageTag: 9d47e368-5d6f-53d2-91fb-dd2620c95015

	measure 'Backtest Forecast' = CALCULATE ( SUM ( fact_backtest[prediction] ), fact_backtest[usable] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 Accuracy
		lineageTag: 9d677953-71d5-5c01-bdd2-4c93b9efbd4e

	measure 'Abs Error' = SUMX ( FILTER ( fact_backtest, fact_backtest[usable] = 1 ), ABS ( fact_backtest[prediction] - fact_backtest[sales] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		displayFolder: 3 Accuracy
		lineageTag: 04df6032-1977-5d4a-af27-45c01564c871

	measure 'Signed Error' = SUMX ( FILTER ( fact_backtest, fact_backtest[usable] = 1 ), fact_backtest[prediction] - fact_backtest[sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		displayFolder: 3 Accuracy
		lineageTag: 5081259d-160a-5683-9771-43d08700193e

	measure 'Backtest Sales (per model)' = CALCULATE ( SUM ( fact_backtest[sales] ), fact_backtest[usable] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		displayFolder: 3 Accuracy
		lineageTag: 1f9dfa6c-529e-533a-afe2-b98e7bc285cd

	measure WAPE = DIVIDE ( [Abs Error], [Backtest Sales (per model)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: a5d2b286-a140-5ad8-bd01-57234a02b9e3

	measure 'Bias %' = DIVIDE ( [Signed Error], [Backtest Sales (per model)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: dc845da0-41b8-5aec-a5f3-f2e5a1de3b2a

	measure MAPE = AVERAGEX ( FILTER ( fact_backtest, fact_backtest[usable] = 1 ), DIVIDE ( ABS ( fact_backtest[prediction] - fact_backtest[sales] ), fact_backtest[sales] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: 435db66b-53df-5f76-a8eb-4f9246a6e57b

	measure 'WAPE Selected Model' = VAR mdl = [Selected Model] RETURN CALCULATE ( [WAPE], fact_backtest[model] = mdl )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: 2fab1872-84c8-5fe9-ab56-119a0c25dc10

	measure 'WAPE Baseline' = CALCULATE ( [WAPE], fact_backtest[model] = "naive" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: 0d44c10b-da67-5171-aa6c-2a6bd13913f4

	measure 'Error Reduction vs Baseline' = 1 - DIVIDE ( [WAPE Selected Model], [WAPE Baseline] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: f3e566d4-da21-595c-ba96-4f02ab42f2f1

	measure 'Bias Selected Model' = VAR mdl = [Selected Model] RETURN CALCULATE ( [Bias %], fact_backtest[model] = mdl )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: f325b21b-d847-530d-8b67-ad172cd21995

	measure 'MAPE Selected Model' = VAR mdl = [Selected Model] RETURN CALCULATE ( [MAPE], fact_backtest[model] = mdl )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Accuracy
		lineageTag: 64c27d52-6538-5934-9b02-defb41486688

	measure 'Forecast Selected Model (Backtest)' = VAR mdl = [Selected Model] RETURN CALCULATE ( [Backtest Forecast], fact_backtest[model] = mdl )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 Accuracy
		lineageTag: ea35f315-b1a0-545a-8df7-aca921190801

	measure 'Forecast Baseline (Backtest)' = CALCULATE ( [Backtest Forecast], fact_backtest[model] = "naive" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 Accuracy
		lineageTag: ca6238b4-e2f5-566e-901e-dac1306644b4

	measure 'Error Reduction Label' = FORMAT ( [Error Reduction vs Baseline], "0%" ) & " lower error than baseline"
		displayFolder: 3 Accuracy
		lineageTag: ab47b76e-999c-58a7-8578-2fb6c3ef8ecc

	measure 'Baseline Label' = "Same weekday last year"
		isHidden
		displayFolder: 9 Helpers
		lineageTag: a866b8d1-05c1-531d-a178-c86ed7d7f3f8

	measure 'Bias Label' = IF ( [Bias Selected Model] >= 0, "Slight over-forecast", "Slight under-forecast" )
		isHidden
		displayFolder: 9 Helpers
		lineageTag: 023f963d-8793-52a0-825d-186ebb24ef81

	measure 'MAPE Label' = "Average daily % error"
		isHidden
		displayFolder: 9 Helpers
		lineageTag: a945c39f-1ca1-519b-a545-9edf404be946

