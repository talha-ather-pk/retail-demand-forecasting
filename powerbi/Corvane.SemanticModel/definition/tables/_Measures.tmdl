	measure 'Store WAPE' = [WAPE Selected Model]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Stores
		lineageTag: 9483ddb3-d92c-5de6-9c5f-a8dca968cf49

	measure Stores = DISTINCTCOUNT ( dim_store[store_id] )
		formatString: #,0
		displayFolder: 5 Stores
		lineageTag: 28ed8bf3-57e2-500d-a897-f6b26059ff35

	measure 'Store Forecast Rank' = IF ( ISINSCOPE ( dim_store[store_name] ), RANKX ( ALLSELECTED ( dim_store[store_name] ), [Forecast], , DESC, DENSE ) )
		formatString: #,0
		displayFolder: 5 Stores
		lineageTag: d049f8b7-f481-52a9-ba0b-eea4d605f595

	measure 'Filter Context' = IF ( ISFILTERED ( dim_store[region] ), CONCATENATEX ( VALUES ( dim_store[region] ), dim_store[region], ", ", dim_store[region], ASC ), "All regions" ) & "   ·   " & IF ( ISFILTERED ( dim_store[format] ), CONCATENATEX ( VALUES ( dim_store[format] ), dim_store[format], ", ", dim_store[format], ASC ), "All formats" ) & "   ·   " & IF ( ISFILTERED ( dim_store[store_name] ), CONCATENATEX ( VALUES ( dim_store[store_name] ), dim_store[store_name], ", ", dim_store[store_name], ASC ), "All 60 stores" ) & "   ·   forecast 1 Jan – 11 Feb 2026"
		displayFolder: 7 Dynamic text
		lineageTag: 3bbb3cf7-b526-5abe-990f-a7c773073278

	measure 'Blank Text' = ""
		isHidden
		displayFolder: 9 Helpers
		lineageTag: 0109dead-4409-51ff-8600-979f6a0051ee

	measure 'Note P10' = "8 in 10 outcomes above this"
		isHidden
		displayFolder: 9 Helpers
