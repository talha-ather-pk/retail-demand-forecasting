	measure 'Promo Lift Flagship' = CALCULATE ( [Estimated Effect], driver_effects[effect] = "Promotion lift, Flagship (basic assortment)" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Drivers
		lineageTag: d8011fb1-73a6-55f5-819d-00ab1ce2531c

	measure 'Promo Lift Express' = CALCULATE ( [Estimated Effect], driver_effects[effect] = "Promotion lift, Express (basic assortment)" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Drivers
		lineageTag: 31471717-c889-545a-ab7e-bab4f966312e

	measure 'Payday Lift' = CALCULATE ( [Estimated Effect], driver_effects[effect] = "Payday (1st-3rd, 15th-16th)" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Drivers
