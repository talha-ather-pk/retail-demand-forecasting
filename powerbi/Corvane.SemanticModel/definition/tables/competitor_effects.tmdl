table competitor_effects
	lineageTag: 5a3096ca-6347-5a5d-a4a2-9d0fa7de8e62

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 592f0c35-cf41-5232-975c-14ba99ab70cc
		summarizeBy: none
		sourceColumn: store_id

		annotation SummarizationSetBy = User

	column new_competitor_distance_m
		dataType: double
		isHidden
		lineageTag: 5270ca6a-b424-5d8d-9c0c-7e5481cd4fe4
		summarizeBy: none
		sourceColumn: new_competitor_distance_m

		annotation SummarizationSetBy = User

	column estimated_hit
		dataType: double
		isHidden
		lineageTag: c4cee6a5-b177-5e1b-8c78-acaf4d00e929
		summarizeBy: none
		sourceColumn: estimated_hit

		annotation SummarizationSetBy = User

	column true_hit
		dataType: double
		isHidden
		lineageTag: 770c144e-e5fc-5846-80b5-bd75e4726292
		summarizeBy: none
		sourceColumn: true_hit

		annotation SummarizationSetBy = User

	partition competitor_effects = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "competitor_effects.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"store_id", "new_competitor_distance_m", "estimated_hit", "true_hit"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"store_id", Int64.Type}, {"new_competitor_distance_m", type number}, {"estimated_hit", type number}, {"true_hit", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
