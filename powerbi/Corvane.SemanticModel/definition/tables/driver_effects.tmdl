	partition driver_effects = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "driver_effects.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"group", "effect", "estimated", "ci_low", "ci_high", "true"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"group", type text}, {"effect", type text}, {"estimated", type number}, {"ci_low", type number}, {"ci_high", type number}, {"true", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
