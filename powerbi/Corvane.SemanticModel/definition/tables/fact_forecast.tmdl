	partition fact_forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "forecast_2026.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"store_id", "date", "open", "promo", "state_holiday", "holiday_name", "school_holiday", "forecast_prophet", "forecast_gbm", "forecast_ensemble", "forecast", "p10", "p90", "model"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"store_id", Int64.Type}, {"date", type date}, {"open", Int64.Type}, {"promo", Int64.Type}, {"state_holiday", Int64.Type}, {"holiday_name", type text}, {"school_holiday", Int64.Type}, {"forecast_prophet", type number}, {"forecast_gbm", type number}, {"forecast_ensemble", type number}, {"forecast", type number}, {"p10", type number}, {"p90", type number}, {"model", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
