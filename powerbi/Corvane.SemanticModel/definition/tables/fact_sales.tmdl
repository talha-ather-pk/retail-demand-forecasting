	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "daily.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"store_id", "date", "open", "promo", "state_holiday", "holiday_name", "school_holiday", "sales", "customers", "is_outage", "usable", "is_future"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"store_id", Int64.Type}, {"date", type date}, {"open", Int64.Type}, {"promo", Int64.Type}, {"state_holiday", Int64.Type}, {"holiday_name", type text}, {"school_holiday", Int64.Type}, {"sales", type number}, {"customers", type number}, {"is_outage", Int64.Type}, {"usable", Int64.Type}, {"is_future", Int64.Type}}, "en-US"),
				    Hist = Table.SelectRows(Typed, each [is_future] = 0)
				in
				    Hist

	annotation PBI_ResultType = Table
